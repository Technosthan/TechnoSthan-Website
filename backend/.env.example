# Backend environment variables example
# Copy this file to .env and fill in production secrets.

PORT=7000
MONGO_URI=mongodb://localhost:27017/agritech
JWT_SECRET=your_jwt_secret
SESSION_SECRET=your_session_secret
FRONTEND_URL=http://localhost:5173

# Default email provider
DEFAULT_EMAIL_PROVIDER=sendgrid

# SendGrid API credentials
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=TechnoSthan
SENDGRID_REPLY_TO_EMAIL=

# Legacy/shared email sender fallback
EMAIL_FROM="AgriTech <no-reply@agritech.com>"

# Resend API credentials
RESEND_API_KEY=

# Optional application settings
CLIENT_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:7000/api/auth/google/callback

# Telegram settings
TELEGRAM_BOT_TOKEN=
TELEGRAM_USE_POLLING=false

# Remove SMTP/Gmail settings when using Resend
# EMAIL_USER=
# EMAIL_PASS=
# SMTP_HOST=
# SMTP_PORT=

# Twilio / OTP (optional)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_WHATSAPP_NUMBER=

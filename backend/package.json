{
  "name": "technosthan-innovation-hub-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js & npm run build:frontend && wait",
    "build:frontend": "cd ../frontend && npm install --include=dev && npm run build",
    "build": "cd ../frontend && npm install --include=dev && npm run build",
    "prisma:init": "prisma init --datasource-provider postgresql",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.9.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.0",
    "dotenv": "^16.4.1",
    "express": "^4.19.2",
    "joi": "^17.13.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^7.0.1",
    "prisma": "^5.9.3",
    "razorpay": "^2.9.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}

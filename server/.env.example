# Environment Variables Template
# Copy this to .env and fill in your actual values

# Database
MONGO_URI=mongodb://localhost:27017/technosthan

# Authentication
JWT_SECRET=your_super_secure_jwt_secret_here_minimum_32_characters
SESSION_SECRET=your_super_secure_session_secret_here_minimum_32_characters

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Email Configuration
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Server Configuration
PORT=5000
NODE_ENV=development

# Security Notes:
# - JWT_SECRET and SESSION_SECRET should be at least 32 characters long
# - Use strong, random strings (not "secret123")
# - Never commit .env file to version control
# - Use different secrets for development and production